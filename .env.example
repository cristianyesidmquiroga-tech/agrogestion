# Copie como .env y reemplace los marcadores. El .env real nunca se versiona.
APP_ENV=development

# Base de datos. PostgreSQL en producción; SQLite solo para desarrollo local.
DATABASE_URL=sqlite+aiosqlite:///./agrogestion.db

# Clave de firma del JWT (mínimo 16 caracteres). Sin valor por defecto: si falta, la app no arranca.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambie-esta-clave-en-produccion

# Clave para cifrar columnas sensibles (documento del trabajador, ubicación).
FIELD_ENCRYPTION_KEY=

# Orígenes de navegador permitidos, separados por coma.
ALLOWED_ORIGINS=http://localhost:3000

# Inicio de sesión: intentos fallidos antes del bloqueo y minutos de bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Vigencia del token en minutos (5 a 1440).
JWT_EXPIRE_MINUTES=60

# Dominios permitidos para las fuentes de alertas regionales.
ALERT_ALLOWED_HOSTS=datosabiertos.dane.gov.co

# Costo de bcrypt (12 en producción; 4 solo en pruebas).
BCRYPT_COST=12

# Peticiones por minuto por dirección; vacío usa 120 en desarrollo y 60 en producción.
RATE_LIMIT=

# Clave de las cuentas ficticias que crea scripts/demo.py.
SEED_PASSWORD=
