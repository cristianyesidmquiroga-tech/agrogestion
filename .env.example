# Copie como .env y reemplace los marcadores. El .env real nunca se versiona.

# Clave de firma del JWT. Sin valor por defecto: si falta, la app no arranca.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AGRO_SECRET_KEY=<pegue-aqui-la-clave-generada>

# PostgreSQL 16, puerto 5434, controlador asíncrono asyncpg.
AGRO_DATABASE_URL=postgresql+asyncpg://<usuario>:<clave>@127.0.0.1:5434/agrogestion

# false fuera del computador de quien desarrolla: true expone trazas completas.
AGRO_DEBUG=false

# Vigencia del token de acceso en minutos (5 a 1440).
AGRO_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Clave de las cuentas ficticias de scripts/demo.py (solo la base de ejemplo local).
AGRO_SEED_PASSWORD=Demo-Local-2026
